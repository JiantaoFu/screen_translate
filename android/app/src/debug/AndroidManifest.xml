<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application>
        <!-- Debug builds (emulator regression, store-asset recording, local
             runs) must not reach GA: they inflated the funnel with test
             sessions. "deactivated" rather than collection_enabled=false:
             Firebase persists setAnalyticsCollectionEnabled(true), which
             older debug builds called, and that saved value overrides
             collection_enabled on an upgrade install, so the native SDK
             could log first_open / session_start before Dart turned it off.
             Deactivation is permanent for the build and cannot be undone at
             runtime. -->
        <meta-data
            android:name="firebase_analytics_collection_deactivated"
            android:value="true" />
        <!-- Debug-only live-translation test harness, see MotionTestActivity. -->
        <activity
            android:name="com.lomoware.screen_translate.MotionTestActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:process=":harness"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    </application>
</manifest>
